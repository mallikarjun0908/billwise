# BillWise Configuration

# Database Configuration (PostgreSQL / Cloud SQL / SQLite fallback)
# Local SQLite default:
DATABASE_URL=sqlite:///./billwise.db

# Cloud SQL / PostgreSQL (uncomment if using PostgreSQL or Google Cloud SQL):
# DATABASE_URL=postgresql+psycopg://billwise_user:your_password@localhost:5432/billwisedb
# Cloud SQL Unix Socket (Cloud Run):
# CLOUD_SQL_CONNECTION_NAME=your-gcp-project:us-central1:billwise-pg
# DB_USER=billwise_user
# DB_PASS=your_password
# DB_NAME=billwisedb

# Google Cloud Firestore (uncomment to enable Firestore mode):
# USE_FIRESTORE=true
# FIRESTORE_PROJECT_ID=your-firebase-project-id

# Bill Upload Storage
# STORE_UPLOADS: Set to 'false' for strict privacy (photos are processed in-memory and discarded).
# Set to 'true' to retain uploaded bills for auditing.
STORE_UPLOADS=true
UPLOAD_DIR=./uploads

# Firebase Cloud Storage (uncomment to store bill photos in Firebase Storage instead of local disk):
# FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com
# STORAGE_BACKEND=firebase

# Server & Cloud Run Settings
PORT=8080
MAX_UPLOAD_MB=10

# Optional LLM Savings Coach (Anthropic Claude)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
